{
  "name": "talep-takip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ambardan malzeme talep formu PDF'lerini OCR/metin katmanıyla ayrıştırıp SQLite'a yazan, tek sayfalık lokal takip sistemi.",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning sunucu.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "ocr-hazirla": "node --no-warnings=ExperimentalWarning -e \"import('./lib/pdf-metin.js').then(m=>m.ocrDilleriniIndir()).then(k=>console.log('OCR dil dosyaları hazır: '+k))\""
  },
  "dependencies": {
    "mupdf": "^1.28.0"
  },
  "optionalDependencies": {
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}